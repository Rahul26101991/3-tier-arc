#!/bin/bash
set -e

apt-get update -y
apt-get install -y python3 python3-pip git postgresql-client

mkdir -p /opt/app
git clone ${repo_url} /opt/app/repo
cd /opt/app/repo

if [ -f requirements.txt ]; then
    python3 -m pip install -r requirements.txt
fi

cat <<EOF > /opt/app/repo/.env
DATABASE_URL=postgresql://postgres:${db_password}@${db_host}:${db_port}/${db_name}?sslmode=disable
EOF

until pg_isready -h "${db_host}" -p "${db_port}" -U postgres; do
  sleep 3
done

cat <<EOF > /etc/systemd/system/nextops-backend.service
[Unit]
Description=NextOps Telemetry Query Service
After=network.target

[Service]
User=root
WorkingDirectory=/opt/app/repo
Environment="DATABASE_URL=postgresql://postgres:${db_password}@${db_host}:${db_port}/${db_name}?sslmode=disable"
ExecStart=/usr/bin/python3 -m uvicorn main:app --host 0.0.0.0 --port ${app_port}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now nextops-backend